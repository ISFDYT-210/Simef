{% extends 'base/base.html' %}
{% block title %}Lista de materias{% endblock %}
{% block encabezado %}Listado de materias{% endblock %}
{% block content %}
{% if request.user.is_staff or request.user.is_superuser or request.user.is_admin %}

<div x-data="materiasAdmin()">

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">

    <!-- Encabezado + filtros + acciones -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-5 py-4">
      <div>
        <h2 class="text-sm font-semibold text-tinta-900">Listado de materias</h2>
        <p class="text-xs text-slate-500"><span x-text="seleccionadas().length"></span> seleccionada(s)</p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <!-- Filtro cascada carrera → año (GET) -->
        <form method="get" class="flex items-center gap-2">
          <select name="carrera" x-ref="carrera" @change="cargarAnios()"
                  class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm focus:border-celeste-500 focus:outline-none focus:ring-2 focus:ring-celeste-100">
            <option value="">Filtrar por carrera</option>
            {% for carrera in carreras %}
            <option value="{{ carrera.id }}" data-duracion="{{ carrera.duracion_carrera }}" {% if request.GET.carrera == carrera.id|stringformat:"s" %}selected{% endif %}>{{ carrera.nombre_carrera }}</option>
            {% endfor %}
          </select>
          <select name="anio" x-ref="anio"
                  class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm focus:border-celeste-500 focus:outline-none focus:ring-2 focus:ring-celeste-100 disabled:bg-slate-100"
                  :disabled="!$refs.carrera.value">
            <option value="">Seleccioná carrera</option>
          </select>
          <button type="submit" title="Buscar" class="grid h-[34px] w-10 place-items-center rounded-lg bg-celeste-600 text-white hover:bg-celeste-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.3-4.3M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Z"/></svg>
          </button>
        </form>

        <button @click="pedir('abrir')" title="Abrir inscripciones" class="inline-flex items-center gap-1.5 rounded-lg bg-celeste-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-celeste-500">Abrir</button>
        <button @click="pedir('cerrar')" title="Cerrar inscripciones" class="inline-flex items-center gap-1.5 rounded-lg bg-slate-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-slate-700">Cerrar</button>
        <button @click="pedir('eliminar')" title="Eliminar" class="inline-flex items-center gap-1.5 rounded-lg bg-red-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-red-700">Eliminar</button>
      </div>
    </div>

    <form id="formMaterias" method="post" :action="accionUrl" x-ref="formMaterias">
      {% csrf_token %}
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-100 text-left text-xs uppercase tracking-wider text-slate-400">
              <th class="px-5 py-3"><input type="checkbox" @change="toggleTodos($event)" x-ref="checkTodos" title="Seleccionar todo" class="h-4 w-4 rounded border-slate-300 text-celeste-600 focus:ring-celeste-500"></th>
              <th class="px-5 py-3 font-semibold">Nombre</th>
              <th class="px-5 py-3 font-semibold">Año</th>
              <th class="px-5 py-3 font-semibold">Inscripción</th>
              <th class="px-5 py-3 font-semibold">Carrera</th>
              <th class="px-5 py-3 font-semibold">Profesor</th>
              <th class="px-5 py-3 font-semibold">Día</th>
              <th class="px-5 py-3 font-semibold">Horario</th>
              <th class="px-5 py-3 font-semibold text-right">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {% for materia in materias %}
            <tr class="hover:bg-slate-50">
              <td class="px-5 py-3"><input type="checkbox" name="materia_ids" value="{{ materia.id }}" @change="sincronizar()" class="materia-check h-4 w-4 rounded border-slate-300 text-celeste-600 focus:ring-celeste-500"></td>
              <td class="px-5 py-3 font-medium text-tinta-900">{{ materia.nombre_materia }}</td>
              <td class="px-5 py-3">{{ materia.anio|default:"—" }}</td>
              <td class="px-5 py-3">{% if materia.inscripcionAbierta %}<span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">Sí</span>{% else %}<span class="rounded-full bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-700">No</span>{% endif %}</td>
              <td class="px-5 py-3">{{ materia.carrera.nombre_carrera|default:"—" }}</td>
              <td class="px-5 py-3">{{ materia.profesor.nombre_completo|default:"—" }}</td>
              <td class="px-5 py-3">{{ materia.dia|default:"—" }}</td>
              <td class="px-5 py-3">{{ materia.Horario|default:"—" }}</td>
              <td class="px-5 py-3">
                <div class="flex items-center justify-end gap-2">
                  <a href="{% url 'ver_materias' id=materia.id %}" title="Ver" class="grid h-8 w-8 place-items-center rounded-lg bg-celeste-600 text-white hover:bg-celeste-500"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="3"/></svg></a>
                  <a href="{% url 'editar_materia' id=materia.id %}" title="Editar" class="grid h-8 w-8 place-items-center rounded-lg bg-celeste-600 text-white hover:bg-celeste-500"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 20h4L18.5 9.5a2.1 2.1 0 0 0-3-3L5 17v3Zm10.5-13 3 3"/></svg></a>
                </div>
              </td>
            </tr>
            {% empty %}
            <tr><td colspan="9" class="px-5 py-10 text-center text-sm text-slate-500">No hay materias disponibles.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </form>

    <!-- Paginación server-side -->
    {% if materias.paginator.num_pages > 1 %}
    <div class="flex items-center justify-between border-t border-slate-200 px-5 py-3 text-sm">
      <p class="text-slate-500">Página {{ materias.number }} de {{ materias.paginator.num_pages }}</p>
      <div class="flex gap-1">
        {% if materias.has_previous %}<a href="?page={{ materias.previous_page_number }}{% if request.GET.carrera %}&carrera={{ request.GET.carrera }}{% endif %}{% if request.GET.anio %}&anio={{ request.GET.anio }}{% endif %}" class="rounded-lg border border-slate-300 px-3 py-1.5 font-medium text-slate-600 hover:bg-slate-50">Anterior</a>{% endif %}
        {% if materias.has_next %}<a href="?page={{ materias.next_page_number }}{% if request.GET.carrera %}&carrera={{ request.GET.carrera }}{% endif %}{% if request.GET.anio %}&anio={{ request.GET.anio }}{% endif %}" class="rounded-lg border border-slate-300 px-3 py-1.5 font-medium text-slate-600 hover:bg-slate-50">Siguiente</a>{% endif %}
      </div>
    </div>
    {% endif %}
  </div>

  <!-- Modal confirmar -->
  <div x-show="modal.abierto" x-cloak class="fixed inset-0 z-50 grid place-items-center bg-black/40 p-4" @click.self="modal.abierto=false" x-transition.opacity>
    <div class="w-full max-w-md rounded-2xl bg-white shadow-xl" @keydown.escape.window="modal.abierto=false">
      <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4">
        <h3 class="text-sm font-semibold text-tinta-900" x-text="modal.titulo"></h3>
        <button @click="modal.abierto=false" class="text-slate-400 hover:text-slate-600"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M6 6l12 12M18 6 6 18"/></svg></button>
      </div>
      <p class="px-5 py-6 text-center text-sm text-slate-700" x-text="modal.mensaje"></p>
      <div class="flex justify-end gap-2 border-t border-slate-200 px-5 py-3">
        <button @click="modal.abierto=false" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50">Cancelar</button>
        <button @click="$refs.formMaterias.submit()" class="rounded-lg px-4 py-2 text-sm font-semibold text-white" :class="modal.tipo==='eliminar'?'bg-red-600 hover:bg-red-700':'bg-tinta-900 hover:bg-tinta-800'" x-text="modal.tipo==='eliminar'?'Eliminar':'Confirmar'"></button>
      </div>
    </div>
  </div>

  <!-- Modal seleccioná una -->
  <div x-show="avisoVacio" x-cloak class="fixed inset-0 z-50 grid place-items-center bg-black/40 p-4" @click.self="avisoVacio=false" x-transition.opacity>
    <div class="w-full max-w-sm rounded-2xl bg-white p-6 text-center shadow-xl">
      <h3 class="text-sm font-semibold text-tinta-900">Advertencia</h3>
      <p class="mt-2 text-sm text-slate-600">Debés seleccionar al menos una materia.</p>
      <button @click="avisoVacio=false" class="mt-4 rounded-lg bg-tinta-900 px-5 py-2 text-sm font-semibold text-white hover:bg-tinta-800">Cerrar</button>
    </div>
  </div>

  {% if cantidad_eliminadas %}
  <div x-data="{ show: true }" x-show="show" x-cloak class="fixed inset-0 z-50 grid place-items-center bg-black/40 p-4" x-transition.opacity>
    <div class="w-full max-w-sm rounded-2xl bg-white p-6 text-center shadow-xl">
      <h3 class="text-sm font-semibold text-tinta-900">Notificación</h3>
      <p class="mt-2 text-sm text-slate-600">{% if cantidad_eliminadas == 1 %}¡La materia fue eliminada correctamente!{% else %}¡Las {{ cantidad_eliminadas }} materias fueron eliminadas correctamente!{% endif %}</p>
      <a href="/lista_materias_admin" class="mt-4 inline-block rounded-lg bg-tinta-900 px-5 py-2 text-sm font-semibold text-white hover:bg-tinta-800">Volver</a>
    </div>
  </div>
  {% endif %}

</div>

<script>
  function materiasAdmin() {
    return {
      avisoVacio: false, accionUrl: '',
      modal: { abierto:false, tipo:'', titulo:'', mensaje:'' },
      urls: { eliminar:"{% url 'eliminar_materias_seleccionadas' %}", abrir:"{% url 'abrir_materias_seleccionadas' %}", cerrar:"{% url 'cerrar_materias_seleccionadas' %}" },

      checks(){ return Array.from(document.querySelectorAll('.materia-check')); },
      seleccionadas(){ return this.checks().filter(c=>c.checked); },
      toggleTodos(e){ this.checks().forEach(c=>c.checked=e.target.checked); },
      sincronizar(){ if(this.$refs.checkTodos){ var t=this.checks(); this.$refs.checkTodos.checked = t.length>0 && t.every(c=>c.checked); } },

      cargarAnios(){
        var sel=this.$refs.carrera, anio=this.$refs.anio;
        var dur=sel.options[sel.selectedIndex]?.getAttribute('data-duracion');
        anio.innerHTML='<option value="">Filtrar por año</option>';
        if(dur){ for(var i=1;i<=dur;i++){ var o=document.createElement('option'); o.value=i; o.text=i; anio.add(o); } }
      },

      pedir(tipo){
        var sel=this.seleccionadas();
        if(sel.length===0){ this.avisoVacio=true; return; }
        var uno=sel.length===1;
        var nombre=uno?sel[0].closest('tr').children[1].textContent.trim():'';
        var txt={
          eliminar:{t:'Advertencia', m:uno?`¿Está seguro que desea eliminar la materia "${nombre}"?`:`¿Está seguro que desea eliminar las ${sel.length} materias seleccionadas?`},
          abrir:{t:'Abrir inscripciones', m:uno?`¿Está seguro que desea abrir las inscripciones para la materia "${nombre}"?`:`¿Está seguro que desea abrir las inscripciones para las ${sel.length} materias seleccionadas?`},
          cerrar:{t:'Cerrar inscripciones', m:uno?`¿Está seguro que desea cerrar las inscripciones para la materia "${nombre}"?`:`¿Está seguro que desea cerrar las inscripciones para las ${sel.length} materias seleccionadas?`},
        };
        this.accionUrl=this.urls[tipo];
        this.modal={abierto:true, tipo, titulo:txt[tipo].t, mensaje:txt[tipo].m};
      },
    };
  }
</script>

{% else %}
<div class="grid min-h-[60vh] place-items-center text-center">
  <div>
    <img src="/static/imagenes/error403.jpg" class="mx-auto max-w-xs rounded-xl" alt="Acceso denegado">
    <p class="mt-4 text-base font-medium text-tinta-900">No deberías estar acá.</p>
    <a href="/" class="mt-3 inline-block rounded-lg bg-tinta-900 px-5 py-2 text-sm font-semibold text-white hover:bg-tinta-800">Volver al inicio</a>
  </div>
</div>
{% endif %}
{% endblock %}

  "cards": [
    {
      "dot": "cyan",
      "title": "Una inscripción a final",
      "items": [
        "El estudiante se inscribe con un POST con CSRF",
        "puede_rendir() exige cursada aprobada, correlativas y oportunidades disponibles",
        "La inscripción se guarda en Neon y queda en la auditoría"
      ]
    },
    {
      "dot": "rose",
      "title": "Seguridad",
      "items": [
        "axes bloquea el login tras 5 intentos fallidos",
        "El primer ingreso obliga a cambiar la contraseña",
        "Cada vista exige un rol o una capacidad"
      ]
    },
    {
      "dot": "emerald",
      "title": "Despliegue",
      "items": [
        "Vercel publica cada merge a main y cada PR tiene su vista previa",
        "main exige que pasen los controles de GitHub Actions",
        "Los PDF se arman en el servidor: los datos no salen a otro servicio"
      ]
    }
  ]
